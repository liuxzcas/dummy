# Dummy Agent — 环境变量配置
# 复制此文件为 .env，填入你的 API Key 后即可使用
# cp .env.example .env
#
# 本项目兼容任何 OpenAI 格式的 LLM API：
#   - DeepSeek（默认）: https://api.deepseek.com
#   - OpenAI: https://api.openai.com/v1
#   - Ollama 本地: http://localhost:11434/v1
#   - vLLM / 其他兼容服务: 按你的服务地址填写
# 只需配置下面三个变量（model 可选）。

# API Key（必填；DeepSeek / OpenAI / 其他兼容服务均可）
DUMMY_API=«redacted:sk-…»

# API 基础地址（可选，默认 https://api.deepseek.com）
# DUMMY_AGENT_BASE_URL=https://api.deepseek.com

# 模型名（可选，默认 deepseek-v4-flash）
# 任何 OpenAI 兼容服务的模型名都可以，如 deepseek-chat / gpt-4o / qwen2.5:7b
# DUMMY_AGENT_MODEL=deepseek-v4-flash
